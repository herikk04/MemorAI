# ============================================================
# MemorAI — Environment variables (template)
# Copy to .env and fill real values. NEVER commit .env.
# ============================================================

# ---- Django ----
DJANGO_SETTINGS_MODULE=memorai.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database ----
# dev default uses SQLite at backend/db.sqlite3; prod uses PostgreSQL
DATABASE_URL=postgres://memorai:memorai@db:5432/memorai

# ---- Cache / Queue ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- AnkiConnect (optional, runs on user's machine) ----
ANKI_CONNECT_URL=http://host.docker.internal:8765

# ---- AI: LLM provider ----
# choose one: openai | anthropic | azure | ollama
LLM_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Azure OpenAI (if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Ollama (local, if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ---- AI: Embeddings / RAG ----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- AI: quotas & cost ----
AI_DAILY_TOKEN_CAP_PER_USER=200000
AI_DAILY_COST_CAP_USD=10
